#
# Pre-commit secret scanner.
#
# Why: autonomous/agentic commits are the most likely way a real bearer token
# or ed25519 private key ever reaches git history (see SECURITY-DECISIONS and
# the constitution's privacy-first stance). This hook is the last gate before
# a secret becomes a pushed, possibly-public artefact.
#
# Behaviour:
#   * If `gitleaks` is installed, use it (authoritative).
#   * Otherwise fall back to a built-in high-signal regex scan so protection
#     exists on any box — including a fresh VPS or a cloud-agent runner where
#     gitleaks may not be installed.
# A hit blocks the commit (exit 1). Bypass deliberately with `--no-verify`.

set -euo pipefail

# Nothing staged with content to scan? (e.g. merge commit) -> allow.
if git diff --cached --quiet; then
  exit 0
fi

red()  { printf '\033[31m%s\033[0m\n' "$1"; }
bold() { printf '\033[1m%s\033[0m\n' "$1"; }

# --- Preferred path: gitleaks --------------------------------------------
if command -v gitleaks >/dev/null 2>&1; then
  if gitleaks protect --staged --redact -v; then
    exit 0
  else
    red "✗ gitleaks flagged a potential secret in the staged changes."
    bold "  Remove it, or bypass intentionally with: git commit --no-verify"
    exit 1
  fi
fi

# --- Fallback path: built-in regex scan ----------------------------------
# Scan only ADDED lines in staged changes. Skip *.example files (intentional
# placeholders) and the lockfiles that legitimately contain hash-like blobs.
added="$(git diff --cached -U0 --no-color --diff-filter=ACM \
          -- . ':(exclude)*.example' ':(exclude)*.sum' ':(exclude)*.lock' \
        | grep -E '^\+' | grep -Ev '^\+\+\+' || true)"

if [ -z "$added" ]; then
  exit 0
fi

# High-signal patterns. Curated to minimise false positives while catching the
# secret shapes most relevant here (PEM private keys, provider tokens, the
# Anthropic + GitHub tokens this automation workflow actually uses).
patterns=(
  '-----BEGIN ([A-Z]+ )?PRIVATE KEY-----'   # any PEM private key block
  'sk-ant-[A-Za-z0-9_-]{20,}'               # Anthropic API key
  'gh[pousr]_[0-9A-Za-z]{36,}'              # GitHub PAT / OAuth / app token
  'github_pat_[0-9A-Za-z_]{22,}'            # GitHub fine-grained PAT
  'AKIA[0-9A-Z]{16}'                        # AWS access key id
  'xox[baprs]-[0-9A-Za-z-]{10,}'            # Slack token
  'AIza[0-9A-Za-z_-]{35}'                   # Google API key
  'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}'  # JWT
)

hit=0
for p in "${patterns[@]}"; do
  # `--` is required: several patterns start with '-' and grep would otherwise
  # parse them as options.
  if printf '%s\n' "$added" | grep -Eq -- "$p"; then
    if [ "$hit" -eq 0 ]; then
      red "✗ Potential secret detected in staged changes (built-in scan):"
      hit=1
    fi
    # Show the matched line with the secret value redacted.
    printf '%s\n' "$added" | grep -E -- "$p" \
      | sed -E "s/($p)/[REDACTED]/g" | sed 's/^/    /'
  fi
done

if [ "$hit" -ne 0 ]; then
  echo
  bold "  gitleaks is not installed — this was the built-in fallback scan."
  bold "  Install gitleaks for stronger coverage. To bypass intentionally:"
  bold "    git commit --no-verify"
  exit 1
fi

exit 0
