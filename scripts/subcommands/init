# SPDX-License-Identifier: Apache-2.0
#
# scripts/subcommands/init — `stargate init`: bring up a fresh Stargate stack
# (local profile), minimum subset per research.md §8 / arch §9.1.
#
# WHAT THIS SHIPS (research §8 "delivered" subset + T088 repair):
#   1. Preflight         — docker + docker compose v2 + docker socket + openssl.
#   2. Project volumes   — create the project-scoped named volumes (resolved
#                          by Compose LABEL, never a literal stargate-* physical
#                          name) and initialise their roots for the non-root
#                          service UIDs (B1 fix).
#   3. Key + pepper gen  — ed25519 inter-plane keypairs + the 32-byte bearer-
#                          token pepper (T092) into the stargate-keys volume
#                          with arch-§4.3 / data-model-§1.7 ownership/perms.
#   4. Compose up        — one authoritative compose command (project name +
#                          compose file + env file) via scripts/lib/compose.sh.
#   5. Healthcheck wait  — `docker compose ps -q <service>`, never guessed
#                          container names (B1 fix). Bounded (default 60 s).
#   6. Verification      — Tor route only (no I2P/Nym/Direct).
#   7. Status table      — DP + CP + Tor sidecar (the components present).
#   8. Exit codes        — 0/10/20/30/40/50/60 (stable contract surface).
#
# T088 (review/sol-review.md#B1) repairs the shipped installer: it previously
# ran `docker compose -f ... up` with no `--env-file` and no project name,
# wrote keys to the literal volume `stargate-keys` (Compose renders that as
# `<project>_stargate-keys`, so keys landed in an unused volume the planes
# never mounted), guessed container names (`docker inspect stargate-dp`) that
# never matched Compose's `<project>-stargate-dp-1` naming, and initialised
# only the key volume — leaving the other writable mounts root-owned so the
# non-root planes could not create their UDS / SQLite / snapshot files.
#
# WHAT IS DEFERRED (T016 §Out-of-scope): --profile selection, admin enrollment
# URL / WebAuthn setup, --force / --repair, export/import/wipe subcommands,
# verification of non-Tor routes. Re-running init against an initialized stack
# is handled ONLY to the extent of M5 (do-not-clobber-keys): if stargate-keys
# already contains the full key+pepper set, generation is skipped (arch §9.3).
#
# EXIT CODES (arch §9.1 §7):
#   0   success
#   10  preflight failure (docker / compose / socket / openssl missing or dead)
#   20  key-generation failure
#   30  compose failure (build / up)
#   40  healthcheck timeout
#   50  verification failure
#   60  mandatory host-network boundary unavailable or ineffective
#
# PRIVACY / SUPPLY-CHAIN:
#   - No outbound network except the Docker daemon socket and the image pulls
#     the daemon performs (Constitution III). No curl/wget, no telemetry.
#   - The key-gen helper reuses the exact debian:12-slim digest pinned in
#     sidecars/tor/Dockerfile (Constitution IV). The T016 contract test
#     cross-checks the two digests match; drift fails the gate.
#   - Private key material (cp.priv/dp.priv) + the pepper live only inside the
#     stargate-keys named volume. Host temp dirs used during generation are
#     0700 and shredded on exit (M11).
#
# RUNTIME-CORRECTNESS GATES (T016 §Analysis residue):
#   R1/R2 key-gen correctness + key FORMAT compatibility are NOT proven by
#   T016's own contract test (structural only). They are gated DOWNSTREAM by
#   tests/contract/control-grpc/transport_test.go (T022): a broken key-gen or
#   an unloadable format fails the mutual-ed25519 handshake there. The full
#   wire-auth contract — including the per-plane X.509 cert derivation from
#   these keys, the peer-pin check, and the version-metadata interceptor — is
#   pinned by tests/contract/compose/inter_plane_wire_test.sh (T095) against
#   contracts/wire-auth.md. If you change the key format here, re-check BOTH
#   T022 and the T095 compose-level test. The T088 Docker-backed regression
#   test (tests/contract/stargate-cli/init_docker_test.sh) gates the B1
#   provisioning path (project-scoped volumes, key+pepper ownership, volume-
#   root init, health discovery, idempotence, two-project isolation).

set -uo pipefail

# Source the authoritative compose-command builder (T088). Provides the
# project/compose-file/env-file defaults, compose_run / compose_cmd /
# compose_env_file / resolve_physical_volume / ensure_project_volume /
# init_volume_root / compose_health_ids helpers, and the UID/GID/mode +
# key/pepper constants (CP_UID/DP_UID/IPC_GID, KEY_*_MODE, PEPPER_MODE,
# KEYS_VOLUME/IPC_VOLUME/..., PEPPER_FILE). Resolve the lib path the same
# way the dispatcher resolves its own dir so it holds under any $0.
case "${BASH_SOURCE[0]}" in
  */*) _SG_INIT_DIR="${BASH_SOURCE[0]%/*}" ;;
  *)   _SG_INIT_DIR="." ;;
esac
case "$_SG_INIT_DIR" in
  /*) : ;;
  *)  _SG_INIT_DIR="$(cd "$_SG_INIT_DIR" && pwd)" ;;
esac
# shellcheck source=lib/compose.sh
. "$_SG_INIT_DIR/../lib/compose.sh"

# ---- tunables -------------------------------------------------------------
: "${STARGATE_HEALTHCHECK_TIMEOUT:=60}"        # arch §9.1 step 4 (seconds)
: "${STARGATE_PROBE_TIMEOUT:=5}"               # verify_tor TCP connect bound (seconds)

# Services init waits on (mirrors compose/docker-compose.local.yml). The
# health loop resolves each by `compose ps -q <service>` (B1: never guessed).
SERVICES=(stargate-dp stargate-control tor)

EXIT_PREFLIGHT=10
EXIT_KEYGEN=20
EXIT_COMPOSE=30
EXIT_HEALTHCHECK=40
EXIT_VERIFY=50
EXIT_HOST_BOUNDARY=60

# ---- helpers --------------------------------------------------------------
say()  { printf '%s\n' "$*" >&2; }
note() { printf 'stargate init: %s\n' "$*" >&2; }

# T162 / Constitution III: only the checked-in local topology and the
# no-host-network test fixture are supported here. A copied/overridden
# production Compose file cannot silently bypass the host policy gate.
host_boundary_required() {
  case "$STARGATE_COMPOSE_FILE" in
    "$_SG_REPO_ROOT/compose/docker-compose.local.yml") return 0 ;;
    "$_SG_REPO_ROOT/tests/contract/stargate-cli/fixtures/fixture-compose.yml") return 1 ;;
    *) note "unsupported Compose file: $STARGATE_COMPOSE_FILE"; return 2 ;;
  esac
}

host_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  else
    sudo -n -- "$@"
  fi
}

# An OUTPUT jump at rule 1 gives the DP uid exactly one way out: replies to
# already established loopback clients. No NEW loopback exception is present;
# in particular a local TCP forwarder cannot mediate external access. The
# DROP target is intentionally silent (no per-packet metadata in logs).
install_owner_rules() {
  local fw
  for fw in iptables ip6tables; do
    if ! host_root "$fw" -w -S STARGATE_DP_OUT >/dev/null 2>&1; then
      host_root "$fw" -w -N STARGATE_DP_OUT || return 1
    fi
    host_root "$fw" -w -F STARGATE_DP_OUT || return 1
    host_root "$fw" -w -A STARGATE_DP_OUT -o lo -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT || return 1
    host_root "$fw" -w -A STARGATE_DP_OUT -j DROP || return 1
    while host_root "$fw" -w -C OUTPUT -m owner --uid-owner "$DP_UID" -j STARGATE_DP_OUT >/dev/null 2>&1; do
      host_root "$fw" -w -D OUTPUT -m owner --uid-owner "$DP_UID" -j STARGATE_DP_OUT || return 1
    done
    host_root "$fw" -w -I OUTPUT 1 -m owner --uid-owner "$DP_UID" -j STARGATE_DP_OUT || return 1
  done
}

verify_host_boundary() {
  local fw output chain first rules
  host_root grep -Fxq 'stargate-dp (enforce)' /sys/kernel/security/apparmor/profiles || return 1
  for fw in iptables ip6tables; do
    output="$(host_root "$fw" -w -S OUTPUT)" || return 1
    first="$(printf '%s\n' "$output" | sed -n '/^-A OUTPUT /{p;q;}')"
    [ "$first" = "-A OUTPUT -m owner --uid-owner $DP_UID -j STARGATE_DP_OUT" ] || return 1
    chain="$(host_root "$fw" -w -S STARGATE_DP_OUT)" || return 1
    rules="$(printf '%s\n' "$chain" | sed -n '/^-A STARGATE_DP_OUT /p')"
    [ "$(printf '%s\n' "$rules" | wc -l)" -eq 2 ] || return 1
    host_root "$fw" -w -C STARGATE_DP_OUT -o lo -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT || return 1
    host_root "$fw" -w -C STARGATE_DP_OUT -j DROP || return 1
    [ "$(printf '%s\n' "$rules" | sed -n '2p')" = '-A STARGATE_DP_OUT -j DROP' ] || return 1
  done
}

install_host_boundary() {
  host_boundary_required
  case "$?" in
    1) return 0 ;; # isolated regression fixture has no host-netns DP
    2) return "$EXIT_HOST_BOUNDARY" ;;
  esac
  # Re-init may encounter a running DP, including after a host firewall
  # flush. Stop it before touching any rule so an intermediate chain state
  # cannot admit traffic. A failed install deliberately leaves it stopped.
  if ! compose_run stop stargate-dp >/dev/null 2>&1; then
    note "cannot stop existing DP before checking host policy"
    return "$EXIT_HOST_BOUNDARY"
  fi
  for tool in sudo iptables ip6tables apparmor_parser; do
    if [ "$tool" = sudo ] && [ "$(id -u)" -eq 0 ]; then continue; fi
    command -v "$tool" >/dev/null 2>&1 || { note "$tool missing; refusing DP startup"; return "$EXIT_HOST_BOUNDARY"; }
  done
  if ! host_root apparmor_parser -T -r "$_SG_REPO_ROOT/compose/apparmor/stargate-dp"; then
    note "cannot load DP AppArmor profile; refusing DP startup"
    return "$EXIT_HOST_BOUNDARY"
  fi
  if ! install_owner_rules || ! verify_host_boundary; then
    note "DP host boundary missing or ineffective; refusing DP startup"
    return "$EXIT_HOST_BOUNDARY"
  fi
}

# tmpdir for host-side key + pepper generation; cleaned on any exit (M11).
KEYS_TMP=""
cleanup() {
  if [ -n "$KEYS_TMP" ] && [ -d "$KEYS_TMP" ]; then
    # Best-effort shred then remove. shred may be absent on macOS/BSD; fall
    # back to rm -rf. The dir is mode 0700 under $TMPDIR.
    if command -v shred >/dev/null 2>&1; then
      find "$KEYS_TMP" -type f -exec shred -u {} + 2>/dev/null
    fi
    rm -rf "$KEYS_TMP" 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM

# ---- 1. PREFLIGHT (arch §9.1 step 1) --------------------------------------
# NOTE: docker presence is checked FIRST so that `PATH= stargate init` exits
# 10 hermetically (T016 M3 behavioural test). Do not add PATH-dependent work
# before this check.
preflight() {
  if ! command -v docker >/dev/null 2>&1; then
    say "docker not found on PATH."
    say "Install Docker: https://docs.docker.com/get-docker/"
    return "$EXIT_PREFLIGHT"
  fi
  if ! docker compose version >/dev/null 2>&1; then
    say "docker compose v2 plugin not available."
    say "Install Docker Compose v2 (shipped with Docker Desktop / the docker-compose-plugin package)."
    return "$EXIT_PREFLIGHT"
  fi
  if ! docker info >/dev/null 2>&1; then
    say "Docker daemon unreachable (is the service running / your user in the docker group?)."
    return "$EXIT_PREFLIGHT"
  fi
  if ! command -v openssl >/dev/null 2>&1; then
    say "openssl not found on PATH (required to generate ed25519 inter-plane keys + the bearer-token pepper)."
    return "$EXIT_PREFLIGHT"
  fi
  return 0
}

# ---- 2. SUPPLY-CHAIN GUARD + PROJECT VOLUMES (arch §9.1 step 3; B1) ---------
# Defence-in-depth (Constitution IV): the key-gen/init helper image runs as
# root with RW on the keys volume. Refuse an unpinned override so a hostile
# env var (CI, dotfile) cannot silently swap in an arbitrary image. The
# default is digest-pinned and cross-checked against sidecars/tor/Dockerfile
# by the contract test; this guard covers the override path. Runs AFTER
# preflight (preflight is the unconditional first gate — T016 M3).
supply_chain_guard() {
  case "$STARGATE_KEYGEN_IMAGE" in
    *@sha256:*) : ;;
    *) note "STARGATE_KEYGEN_IMAGE must be digest-pinned (@sha256:<64hex>); refusing unpinned image: $STARGATE_KEYGEN_IMAGE"
       return "$EXIT_KEYGEN" ;;
  esac
  # redteam Minor #3: surface an audit-trail note when the key-handling
  # root-RW helper image differs from the contract-tested default, so a
  # hostile *@sha256:* override (corporate mirror, debug image) set via
  # dotfile/CI env is not invisible.
  if [ "$STARGATE_KEYGEN_IMAGE" != "$STARGATE_KEYGEN_IMAGE_DEFAULT" ]; then
    note "STARGATE_KEYGEN_IMAGE override in effect (differs from default $STARGATE_KEYGEN_IMAGE_DEFAULT): $STARGATE_KEYGEN_IMAGE"
  fi
  # Suppress core dumps for the duration of key generation so a crash does
  # not write private-key bytes to a host core_pattern location outside the
  # 0700 tmpdir (redteam INFO; cheap defence-in-depth).
  ulimit -c 0 2>/dev/null || true
  # Pre-pull the helper image (a daemon-side operation needing the daemon's
  # own network) so the hardened helpers below can run with --network none
  # against the cached image (redteam Major #1: no egress for the key-
  # handling root container). Pull is idempotent; absence is fatal (keygen
  # cannot proceed without the helper).
  if ! docker image inspect "$STARGATE_KEYGEN_IMAGE" >/dev/null 2>&1; then
    note "pulling keygen helper image (first run)…"
    if ! docker pull "$STARGATE_KEYGEN_IMAGE" >/dev/null 2>&1; then
      note "docker pull $STARGATE_KEYGEN_IMAGE failed (cannot run the keygen helper)."
      return "$EXIT_KEYGEN"
    fi
  fi
  return 0
}

# Create the project-scoped writable volumes (B1: resolve physical names by
# Compose label, never a literal stargate-* physical name) and initialise
# their roots for the non-root service UIDs — empty named-volume roots are
# root-owned, so UID 5101/5102 cannot create their UDS / SQLite / snapshot
# files there. stargate-keys root is chowned before the key+pepper install
# step; the four state volumes to their owning plane. T167 also prepares
# the config volume's child mountpoint before Compose mounts it read-only.
ensure_volumes() {
  local vol phys
  for vol in "$KEYS_VOLUME" "$IPC_VOLUME" "$CONTROL_STATE_VOLUME" \
             "$CONTROL_CONFIG_VOLUME" "$DP_STATE_VOLUME" "$TOR_CONFIG_VOLUME"; do
    phys="$(ensure_project_volume "$vol")"
    [ -n "$phys" ] || { note "ensure_project_volume failed for $vol"; return "$EXIT_KEYGEN"; }
  done
  # stargate-keys: CP-owned (writes pubs/pepper at runtime), group ipc.
  init_volume_root "$(ensure_project_volume "$KEYS_VOLUME")" \
    "$CP_UID" "$IPC_GID" 0750 \
    || { note "init_volume_root failed for $KEYS_VOLUME"; return "$EXIT_KEYGEN"; }
  # stargate-ipc: both planes create UDS sockets → group-writable (0770),
  # group stargate-ipc. Owner is DP (arbitrary); CP writes via the group.
  init_volume_root "$(ensure_project_volume "$IPC_VOLUME")" \
    "$DP_UID" "$IPC_GID" 0770 \
    || { note "init_volume_root failed for $IPC_VOLUME"; return "$EXIT_KEYGEN"; }
  init_volume_root "$(ensure_project_volume "$CONTROL_STATE_VOLUME")" \
    "$CP_UID" "$IPC_GID" 0750 \
    || { note "init_volume_root failed for $CONTROL_STATE_VOLUME"; return "$EXIT_KEYGEN"; }
  init_volume_root "$(ensure_project_volume "$DP_STATE_VOLUME")" \
    "$DP_UID" "$IPC_GID" 0750 \
    || { note "init_volume_root failed for $DP_STATE_VOLUME"; return "$EXIT_KEYGEN"; }
  init_volume_root "$(ensure_project_volume "$TOR_CONFIG_VOLUME")" \
    "$CP_UID" "$IPC_GID" 0750 \
    || { note "init_volume_root failed for $TOR_CONFIG_VOLUME"; return "$EXIT_KEYGEN"; }
  init_control_config_mountpoint "$(ensure_project_volume "$CONTROL_CONFIG_VOLUME")" \
    || { note "init_control_config_mountpoint failed for $CONTROL_CONFIG_VOLUME"; return "$EXIT_KEYGEN"; }
  return 0
}

# ---- 3. KEY + PEPPER GENERATION (arch §9.1 step 3; arch §4.3; data-model §1.7)
# Generate ed25519 keypairs on the host with openssl (PKCS#8 PEM — loadable by
# Go crypto/x509 and Java PKCS8EncodedKeySpec; T022 §handshake gates format
# compatibility), plus the 32-byte bearer-token pepper (T092), then install
# them into the project-scoped stargate-keys volume with the correct
# ownership and modes via a throwaway debian:12-slim container.
#
# WIRE CONTRACT (T095, contracts/wire-auth.md): this script installs KEYS +
# pepper ONLY. The X.509 certificates used for the TLS-over-UDS handshake are
# NOT generated here; each plane derives its own self-signed cert from its
# *.priv key at process startup and holds it in memory only (never
# persisted). T038/T045/T050 consume contracts/wire-auth.md verbatim for the
# derivation recipe; this comment is the installer-side half of the contract.
generate_keys() {
  local keys_phys
  keys_phys="$(ensure_project_volume "$KEYS_VOLUME")"
  [ -n "$keys_phys" ] || { note "cannot resolve $KEYS_VOLUME volume"; return "$EXIT_KEYGEN"; }

  # M5 (arch §9.3): never clobber existing keys — would invalidate enrolled
  # devices. Count the 4 key files + the pepper already present (0 → fresh;
  # 5 → initialised; 1–4 → corrupt partial state).
  local existing
  # HARDENED (redteam round-2): --network none closes the network exfil
  # channel, and this probe runs as the NON-ROOT volume OWNER (5101:5100)
  # with ALL caps dropped — `[ -e ]` needs only SEARCH on the 0750 /keys
  # root (owner has it), so existence is detectable WITHOUT reading any
  # 0600 key/pepper contents (no DAC_OVERRIDE, not root). The stdout is
  # sanitized below before ANY interpolation, so even a backdoored helper's
  # stdout can never reach an operator-visible log line.
  # FAIL-CLOSED (T106, arch §9.3 do-not-clobber): a non-zero exit from the
  # probe (transient daemon hiccup / OOM / attacker-induced helper crash)
  # MUST NOT default to "0" (fresh) — that would regenerate ed25519 keys +
  # pepper over existing ones and invalidate every enrolled device. Abort
  # as EXIT_KEYGEN; only a successful 0-5 count reaches the decision below.
  existing=$(docker run --rm --network none --cap-drop ALL --read-only \
    --user "$CP_UID:$IPC_GID" \
    -v "${keys_phys}:/keys:ro" "$STARGATE_KEYGEN_IMAGE" \
    sh -c 'n=0; for f in cp.priv dp.priv cp.pub dp.pub pepper.key; do [ -e "/keys/$f" ] && n=$((n+1)); done; echo "$n"; exit 0' \
    2>/dev/null) || { note "count-probe helper failed (docker run non-zero exit); aborting to avoid clobbering existing keys"; return "$EXIT_KEYGEN"; }
  # Sanitize before interpolation: a legit count is one digit 0-5. Anything
  # else (a backdoored helper emitting key bytes / garbage on stdout) aborts
  # WITHOUT echoing the value — closes the stdout→stderr exfil channel.
  case "$existing" in
    [0-5]) : ;;
    *) note "$KEYS_VOLUME count-probe returned non-numeric output (possible helper tamper); aborting keygen without echoing the value."
       return "$EXIT_KEYGEN" ;;
  esac
  case "${existing:-0}" in
    5)
      note "$KEYS_VOLUME already initialised (4/4 keys + pepper present); skipping key+pepper generation (arch §9.3)."
      return 0
      ;;
    0)
      :   # fresh volume — proceed to generate
      ;;
    *)
      note "$KEYS_VOLUME is partially initialised (${existing}/5 key+pepper files present) — refusing to regenerate or proceed."
      note "Manual recovery required: inspect volume $keys_phys and either complete or wipe it."
      return "$EXIT_KEYGEN"
      ;;
  esac

  KEYS_TMP="$(mktemp -d /dev/shm/stargate.keys.XXXXXX 2>/dev/null || mktemp -d)" || { note "mktemp failed"; return "$EXIT_KEYGEN"; }
  chmod 0700 "$KEYS_TMP"
  # redteam Info #4: prefer tmpfs (/dev/shm on Linux) so the ed25519 private
  # keys + pepper never touch persisted storage (shred is ineffective on COW
  # / SSD / journaled FS). Fallback to $TMPDIR where /dev/shm is absent
  # (macOS/BSD); that fallback is accepted residue under THREAT-MODEL §3.1
  # (local execution is already game-over).

  local prefix priv pub
  for prefix in cp dp; do
    priv="$KEYS_TMP/$prefix.priv"
    pub="$KEYS_TMP/$prefix.pub"
    if ! openssl genpkey -algorithm ED25519 -out "$priv" 2>/dev/null; then
      note "openssl genpkey ED25519 failed for $prefix"
      return "$EXIT_KEYGEN"
    fi
    if ! openssl pkey -in "$priv" -pubout -out "$pub" 2>/dev/null; then
      note "openssl pkey (pubout) failed for $prefix"
      return "$EXIT_KEYGEN"
    fi
    chmod "$KEY_PRIVATE_MODE" "$priv"
    chmod "$KEY_PUBLIC_MODE" "$pub"
  done

  # T092 amendment (data-model §1.7): 32-byte bearer-token pepper, generated
  # once at install, shared by CP (mints verifiers) and DP (mints candidate
  # tags). Never regenerated short of explicit operator rotation. NOTE: the
  # spec's `openssl rand -bytes 32` shorthand is not valid openssl CLI (no
  # -bytes flag); the real form is `openssl rand -out <file> 32` (T088
  # grounding reconciliation, same class as the pepper-path fix).
  if ! openssl rand -out "$KEYS_TMP/$PEPPER_FILE" 32 2>/dev/null; then
    note "openssl rand (pepper) failed"
    return "$EXIT_KEYGEN"
  fi
  chmod "$PEPPER_MODE" "$KEYS_TMP/$PEPPER_FILE"

  # Install into the project-scoped volume with correct ownership/mode.
  # Private keys: 0600 owned by the owning plane's UID. Public keys: 0644
  # (both planes read both pubs for the mutual handshake). Pepper: 0640 owned
  # by stargate-cp (the provisioner), group stargate-ipc so BOTH planes read
  # it via their shared supplementary GID. `install` runs inside the
  # container as root (default), so chown to arbitrary UID works. The host
  # temp dir is mounted :ro so the container cannot mutate the source.
  # HARDENED (redteam Major #1): --network none is the load-bearing anti-exfil
  # gate. CAP_CHOWN + CAP_FOWNER do the install -o/-g/-m work; DAC_OVERRIDE is
  # retained so root can read the host-generated 0600 private keys in /src:ro
  # (a network-less, read-rootfs, scoped-mount helper cannot exfiltrate them).
  if ! docker run --rm --network none --cap-drop ALL \
        --cap-add CHOWN --cap-add FOWNER --cap-add DAC_OVERRIDE \
        --read-only --tmpfs /tmp \
        -v "${keys_phys}:/keys" \
        -v "${KEYS_TMP}:/src:ro" \
        "$STARGATE_KEYGEN_IMAGE" \
        sh -c '
          set -e
          install -m '"$KEY_PRIVATE_MODE"' -o '"$CP_UID"' -g '"$IPC_GID"' /src/cp.priv /keys/cp.priv
          install -m '"$KEY_PRIVATE_MODE"' -o '"$DP_UID"' -g '"$IPC_GID"' /src/dp.priv /keys/dp.priv
          install -m '"$KEY_PUBLIC_MODE"'  -o '"$CP_UID"' -g '"$IPC_GID"' /src/cp.pub  /keys/cp.pub
          install -m '"$KEY_PUBLIC_MODE"'  -o '"$DP_UID"' -g '"$IPC_GID"' /src/dp.pub  /keys/dp.pub
          install -m '"$PEPPER_MODE"'      -o '"$CP_UID"' -g '"$IPC_GID"' /src/'"$PEPPER_FILE"' /keys/'"$PEPPER_FILE"'
        ' >/dev/null 2>&1; then
    note "installing keys+pepper into $keys_phys failed"
    return "$EXIT_KEYGEN"
  fi

  note "generated ed25519 inter-plane keys + bearer-token pepper in $keys_phys (cp.priv/dp.priv 0600, cp.pub/dp.pub 0644, pepper.key 0640)."
  return 0
}

# ---- 4. COMPOSE UP (arch §9.1 step 4) --------------------------------------
# One authoritative compose command (project name + compose file + env file)
# via compose_run (T088/B1). Bounded healthcheck wait; on timeout exit 40 and
# LEAVE CONTAINERS UP (arch §9.2) so the operator can inspect `docker logs`.
# init never tears the stack down on failure (no destructive teardown on the
# healthcheck-timeout path).
compose_up() {
  note "building + starting stack (project $STARGATE_PROJECT, $STARGATE_COMPOSE_FILE)..."
  if ! compose_run up -d --build >/dev/null 2>&1; then
    note "docker compose up failed (see logs)."
    return "$EXIT_COMPOSE"
  fi
  return 0
}

# ---- 5. HEALTHCHECK WAIT (arch §9.1 step 4; arch §9.2 on timeout) ----------
# Health discovery via `compose ps -q <service>` against the project — never
# guessed container names like `<project>-stargate-dp-1` (B1). A "no
# healthcheck defined" container is accepted as healthy once State.Running is
# true (mirrors the T016 heuristic; real healthcheck: blocks are a separate
# ticket).
wait_healthy() {
  local deadline=$(( $(date +%s) + STARGATE_HEALTHCHECK_TIMEOUT ))
  note "waiting up to ${STARGATE_HEALTHCHECK_TIMEOUT}s for services to be healthy..."
  local all_ok s cid running health
  while [ "$(date +%s)" -lt "$deadline" ]; do
    all_ok=true
    for s in "${SERVICES[@]}"; do
      cid="$(compose_health_ids "$s" | head -n1)"
      if [ -z "$cid" ]; then all_ok=false; break; fi
      running="$(docker inspect -f '{{.State.Running}}' "$cid" 2>/dev/null || echo false)"
      health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$cid" 2>/dev/null || echo none)"
      case "$running:$health" in
        true:none|true:healthy) : ;;            # ok
        *) all_ok=false ;;
      esac
    done
    "$all_ok" && return 0
    sleep 2
  done
  note "healthcheck timeout — services did not all report healthy within ${STARGATE_HEALTHCHECK_TIMEOUT}s."
  note "Containers have been LEFT UP (arch §9.2) — inspect with:"
  note "  $(compose_cmd) logs"
  return "$EXIT_HEALTHCHECK"
}

# ---- 6. TOR-ONLY VERIFICATION (research §8) --------------------------------
# Probe ONLY the Tor route surface: the data plane's loopback proxy port
# (8881) accepts a connection. No I2P, Nym, or Direct route probe — those
# routes are out of scope this feature. Verify failure → 50.
verify_tor() {
  note "verifying Tor route (loopback proxy 127.0.0.1:8881)..."
  # A TCP connect to 127.0.0.1:8881 succeeding proves the DP listener came up.
  # We do NOT drive a full SOCKS5 handshake here — that is the job of the
  # downstream runtime contract tests (T019b/T019c). Keep this probe cheap.
  #
  # The connect MUST be bounded. A bare `(exec 3<>/dev/tcp/...)` inherits the
  # kernel's SYN-retry budget (~130s on Linux) whenever the SYN is DROPPED
  # rather than refused — a firewall DROP rule, some Docker publish paths, or
  # a container whose port is published but whose listener never accept()s.
  # `stargate init` then reads as hung rather than reporting a diagnosis, and
  # the T088 contract test calls init three times, paying it three times over.
  # See redteam/findings/open/20260727-011-verify-tor-unbounded-connect.md.
  local rc
  if command -v timeout >/dev/null 2>&1; then
    timeout "$STARGATE_PROBE_TIMEOUT" \
      bash -c 'exec 3<>/dev/tcp/127.0.0.1/8881' 2>/dev/null
    rc=$?
  else
    # No coreutils `timeout` (stock macOS/BSD — same gap `cleanup` handles for
    # `shred`). Bound it with a bash-native watchdog rather than reverting to
    # an unbounded connect, so the fix holds on every platform init supports.
    ( exec 3<>/dev/tcp/127.0.0.1/8881 ) 2>/dev/null &
    local probe=$! waited=0
    while kill -0 "$probe" 2>/dev/null && [ "$waited" -lt "$STARGATE_PROBE_TIMEOUT" ]; do
      sleep 1
      waited=$(( waited + 1 ))
    done
    if kill -0 "$probe" 2>/dev/null; then
      kill -TERM "$probe" 2>/dev/null
      wait "$probe" 2>/dev/null
      rc=124                      # match coreutils `timeout`'s timeout status
    else
      wait "$probe"; rc=$?
    fi
  fi

  # Refused and timed-out are different diagnoses and must read differently:
  # the first means the listener is down, the second means something is
  # swallowing the SYN with the port published.
  case "$rc" in
    0)
      note "Tor route reachable on 127.0.0.1:8881."
      return 0
      ;;
    124)
      note "127.0.0.1:8881 timed out after ${STARGATE_PROBE_TIMEOUT}s — port published but nothing accepting (inspect the stargate-dp container)."
      ;;
    *)
      note "127.0.0.1:8881 refused — data plane listener did not come up."
      ;;
  esac
  return "$EXIT_VERIFY"
}

