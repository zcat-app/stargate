<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>app.zcat.stargate</groupId>
    <artifactId>control-plane</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Stargate Control Plane (parent)</name>
    <description>
        Quarkus multi-module reactor for the Stargate control plane. Loads
        tokens.yaml, observes sidecar lifecycle via gRPC, writes the audit
        log, exposes a healthcheck. Per Constitution Principle II, request
        bytes never flow through this plane.
    </description>

    <modules>
        <module>api</module>
        <module>core</module>
        <module>persistence</module>
        <module>ui</module>
        <module>runtime</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Quarkus 3.33 LTS — constitution v1.1.0 / research.md §1 -->
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.version>3.33.1</quarkus.platform.version>

        <!-- Quarkiverse JDBC SQLite — independent versioning from Quarkus BOM -->
        <quarkus-jdbc-sqlite.version>3.0.11</quarkus-jdbc-sqlite.version>

        <!-- Pinned plugin versions for byte-reproducibility (arch §12.2) -->
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.3</surefire-plugin.version>
        <failsafe-plugin.version>3.5.3</failsafe-plugin.version>

        <!-- Static nullness enforcement (T104; ported from infochat decision
             D48). Pinned to specific versions — never RELEASE/LATEST. Checked
             against Maven Central metadata at wiring time (2026-09-02):
             error_prone_core 2.42.0→2.50.0, nullaway 0.10.25→0.14.1,
             jspecify 1.0.0 unchanged; compiler-plugin 3.13.0→3.15.0 (latest
             stable 3.x; 4.x is beta). -->
        <error-prone.version>2.50.0</error-prone.version>
        <nullaway.version>0.14.1</nullaway.version>
        <jspecify.version>1.0.0</jspecify.version>

        <!-- Reproducible JVM build (Constitution Principle VI, arch §12.2,
             T098). Pinned epoch matches the extension zip's canonical
             SOURCE_DATE_EPOCH=0 form (1980-01-01, the DOS-time floor) so
             every Stargate artefact carries the same build date.
             maven-archiver keys off this property: fixed entry timestamps,
             sorted entries, canonical file modes. Gated by
             tests/reproducibility/jvm_test.sh. -->
        <project.build.outputTimestamp>1980-01-01T00:00:00Z</project.build.outputTimestamp>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.quarkiverse.jdbc</groupId>
                <artifactId>quarkus-jdbc-sqlite</artifactId>
                <version>${quarkus-jdbc-sqlite.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Inherited by every reactor module, version-less (BOM-managed-versions
         invariant). provided scope: compile-time annotations only, never on
         the runtime classpath (T104). -->
    <dependencies>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>${quarkus.platform.group-id}</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.platform.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <!-- Error Prone + NullAway (T104; infochat D48).
                             NullAway treats app.zcat.stargate as
                             @NonNull-by-default (AnnotatedPackages);
                             genuinely-nullable parameters, returns, and fields
                             carry @Nullable (JSpecify). @NonNull is never
                             written — non-null is the default.
                             Tests are exempted per module via the
                             default-testCompile stanza (main sources only
                             until T104a onboards them). -->
                        <!-- Error Prone needs deep reflective access into the
                             javac internals; fork runs javac in a child JVM so
                             the JVM add-exports / add-opens args passed via
                             -J below reach the compiler rather than this
                             Maven JVM. -->
                        <fork>true</fork>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>com.google.errorprone</groupId>
                                <artifactId>error_prone_core</artifactId>
                                <version>${error-prone.version}</version>
                            </path>
                            <path>
                                <groupId>com.uber.nullaway</groupId>
                                <artifactId>nullaway</artifactId>
                                <version>${nullaway.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-XDcompilePolicy=simple</arg>
                            <arg>--should-stop=ifError=FLOW</arg>
                            <!-- The EP + NullAway flags MUST share ONE <arg>
                                 element: split across elements, javac receives
                                 them as separate arguments and the ErrorProne
                                 plugin never sees the -XepOpt/-Xep flags —
                                 NullAway silently does not run
                                 (green-but-not-enforced; infochat got bitten).
                                 ExcludedFieldAnnotations exempts
                                 framework-initialized fields from the
                                 field-init check: @Inject (CDI) and
                                 @ConfigProperty (MicroProfile Config) are
                                 field-level so the exemption matches directly.
                                 The list also carries
                                 jakarta.annotation.PostConstruct —
                                 deliberately inert: it is a method-level
                                 annotation and can never annotate a field, so
                                 it never matches. A field initialized inside a
                                 @PostConstruct method is therefore NOT
                                 exempted — those fields carry
                                 @SuppressWarnings("NullAway.Init") at the
                                 declaration instead (suppresses only the init
                                 check, keeping the @NonNull dereference
                                 contract). -XepExcludedPaths drops generated
                                 sources (quarkus-grpc stubs) from analysis. -->
                            <arg>-Xplugin:ErrorProne -XepOpt:NullAway:AnnotatedPackages=app.zcat.stargate -XepOpt:NullAway:ExcludedFieldAnnotations=jakarta.inject.Inject,jakarta.annotation.PostConstruct,org.eclipse.microprofile.config.inject.ConfigProperty -XepExcludedPaths:.*/target/generated-sources/.* -Xep:NullAway:ERROR -Xep:MissingOverride:ERROR -Xep:ReferenceEquality:ERROR -Xep:FallThrough:ERROR -Xep:MissingCasesInEnumSwitch:ERROR -Xep:DefaultCharset:ERROR -Xep:JdkObsolete:ERROR -Xep:FutureReturnValueIgnored:ERROR</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${failsafe-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>io.github.zlika</groupId>
                    <artifactId>reproducible-build-maven-plugin</artifactId>
                    <version>0.17</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Re-writes built jars deterministically (strips pom.properties
                 timestamps, normalises manifest) — belt and suspenders on top
                 of maven-archiver's outputTimestamp mode; mandated by
                 arch §12.2 for JVM bytecode reproducibility. strip-jar needs
                 an explicit execution to bind (no default lifecycle
                 mapping); it defaults to the package phase, after jar:jar. -->
            <plugin>
                <groupId>io.github.zlika</groupId>
                <artifactId>reproducible-build-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>strip-jar-modules</id>
                        <phase>package</phase>
                        <goals>
                            <goal>strip-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
