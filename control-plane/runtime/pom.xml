<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.zcat.stargate</groupId>
        <artifactId>control-plane</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>runtime</artifactId>

    <name>Stargate Control Plane :: runtime</name>
    <description>
        The runnable Quarkus application. Aggregates the api / core /
        persistence / ui sibling modules and invokes the quarkus-maven-plugin
        to produce the deployable fast-jar the Dockerfile ENTRYPOINT copies
        (T003a). The StargateControlPlane.java entry point and the production
        boot sequence land here (T041).
    </description>

    <dependencies>
        <dependency>
            <groupId>app.zcat.stargate</groupId>
            <artifactId>api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>app.zcat.stargate</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>app.zcat.stargate</groupId>
            <artifactId>persistence</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>app.zcat.stargate</groupId>
            <artifactId>ui</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- T104: main sources inherit the parent's Error Prone + NullAway
         compiler config via pluginManagement; this stanza clears compilerArgs
         on default-testCompile so tests stay ungated until this module
         onboards them (T104a pattern). -->
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.self="override"/>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- T041: produce the runnable fast-jar (runtime/target/quarkus-app/)
                 that the Dockerfile ENTRYPOINT (T003a) copies — the "activates
                 the quarkus-maven-plugin in runtime/" contract T040 deferred
                 here. build binds to package; generate-code is inert for this
                 module (the proto stubs are api/'s) but keeps the standard
                 execution shape. -->
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate-code</goal>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
