<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.zcat.stargate</groupId>
        <artifactId>control-plane</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ui</artifactId>

    <name>Stargate Control Plane :: ui (v1 healthcheck stub)</name>
    <description>
        Stub in v1 of the 001-tor-route feature. Serves exactly one HTTP
        surface — the compose healthcheck GET /healthz (T040, gated by
        HealthEndpointTest); the admin UI lands in a later
        feature spec (spec.md §Assumptions "No Quarkus dashboard UI yet").
    </description>

    <dependencies>
        <!-- T040: the ONLY HTTP surface is the compose healthcheck, so the
             substrate is bare quarkus-vertx-http with one route registered
             by observing the Router (Quarkus 3.33 ships no declarative
             @Route annotation) — deliberately not quarkus-rest/Qute: the
             stub must "serve nothing else" (research.md §"Decision",
             headless CP), and the future admin-UI feature picks its own
             stack. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-vertx-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- T104: the module ships a single source set (the T040 healthcheck
         endpoint); the stanza below clears compilerArgs on
         default-testCompile so tests stay outside the Error Prone +
         NullAway main-source gate until onboarded (T104a pattern). -->
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.self="override"/>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
