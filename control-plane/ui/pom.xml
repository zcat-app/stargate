<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.zcat.stargate</groupId>
        <artifactId>control-plane</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>ui</artifactId>

    <name>Stargate Control Plane :: ui (v1 loopback health stub)</name>
    <description>
        Stub in v1 of the 001-tor-route feature. Serves exactly one HTTP
        surface — the loopback GET /healthz stub (T040/T204, gated by
        HealthEndpointTest); the admin UI lands in a later
        feature spec (spec.md §Assumptions "No Quarkus dashboard UI yet").
    </description>

    <dependencies>
        <!-- The health-only Router and pre-listen option guard share the bare
             HTTP substrate. Compose does not poll it (Constitution III). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-vertx-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- T104: the module ships a single source set (the T040 healthcheck
         endpoint); the stanza below clears compilerArgs on
         default-testCompile so tests stay outside the Error Prone +
         NullAway main-source gate until onboarded (T104a pattern). -->
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.self="override"/>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Index both the health route and boundary beans so the runtime
                 artifact discovers their observers and pre-listen callbacks. -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
