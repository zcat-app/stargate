<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.zcat.stargate</groupId>
        <artifactId>control-plane</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>persistence</artifactId>

    <name>Stargate Control Plane :: persistence</name>
    <description>
        Hibernate ORM + Panache entities for audit_log and enrolled_devices
        (data-model.md §4), Flyway migrations under
        src/main/resources/db/migration (V001__init.sql lands the full
        architecture-spec §6 schema up-front; this feature only writes
        the two tables named above), JDBC SQLite driver via Quarkiverse.
    </description>

    <dependencies>
        <!-- T036: AuditLogService implements core's TokenLoaderContract.AuditSink
             seam (T035a), so the tokens.yaml loader binds this production
             adapter directly. Direction is ports-in-core / adapters-in-
             persistence; core has no reverse dependency (no cycle). -->
        <dependency>
            <groupId>app.zcat.stargate</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-orm-panache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.jdbc</groupId>
            <artifactId>quarkus-jdbc-sqlite</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- T041: this module's CDI beans (AuditLogService T036,
                 SqliteTokenState) are injected by the runtime module's
                 StargateControlPlane — a sibling jar without an index is
                 treated as a library and its beans are NOT discovered at
                 the runtime build (ArC "Unsatisfied dependency"). The
                 Jandex index marks the jar as an application archive. -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
