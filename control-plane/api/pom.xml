<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>app.zcat.stargate</groupId>
        <artifactId>control-plane</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>api</artifactId>

    <name>Stargate Control Plane :: api</name>
    <description>
        gRPC services exposed by the control plane on
        /run/stargate/control.sock (WatchEvents) and the gRPC client wiring
        to the DP-hosted RPCs (ReloadTokens, GetStatus) on
        /run/stargate/dp.sock. Quarkus-gRPC handles code generation from
        proto/stargate/v1/*.proto at build time.
    </description>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-grpc</artifactId>
        </dependency>
    </dependencies>

    <!--
        The proto contracts live at the repo top (proto/stargate/v1/*.proto)
        so both planes import from one source (plan.md §"Structure Decision").
        By default quarkus-grpc's GrpcCodeGen scans src/main/proto. The
        quarkus.grpc.codegen.proto-directory property (read by
        io.quarkus.grpc.codegen.GrpcCodeGen.init from the Maven project
        properties passed to CodeGenerator.initAndRun) overrides that with an
        absolute path to the shared repo-root proto directory. Declaring it
        here as a POM property promotes it to MavenProject.getProperties(),
        which is what the generate-code mojo feeds into the codegen.
    -->
    <properties>
        <quarkus.grpc.codegen.proto-directory>${project.basedir}/../../proto/stargate/v1</quarkus.grpc.codegen.proto-directory>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-grpc-stubs</id>
                        <goals>
                            <goal>generate-code</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
