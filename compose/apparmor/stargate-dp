# T162 / Constitution III: the DP shares the host network namespace for the
# loopback listener. Never grant generic AF_UNIX: a host abstract socket could
# relay its traffic out of the owner-match firewall (T134 A.12).
profile stargate-dp flags=(attach_disconnected,mediate_deleted) {
  /opt/stargate/stargate-proxy mr,
  /etc/passwd r,
  /etc/group r,
  /etc/hostname r,
  /etc/hosts r,
  /etc/stargate/keys/** r,
  # T178 / Principle II: open the state directory for fsync after snapshot rename.
  /var/lib/stargate/ r,
  /var/lib/stargate/** rwk,
  /run/stargate/ rw,
  /run/stargate/control.sock rw,
  /run/stargate/dp.sock rwk,
  /run/stargate-tor/tor-socks.sock rw,
  # AppArmor resolves the hardlink to Tor's original inode path even when the
  # DP dials through its read-only fabric mount (verified by the live denial).
  /run/tor-fabric/private/tor-socks.sock rw,
  /dev/null rw,
  # T191 / Constitution III: the DP shares the host network namespace, so any
  # /proc/<pid>/net file is the HOST's socket, ARP and route table. Grant only
  # the procfs reads the static Go DP needs (measured with strace): the
  # runtime's cgroup-aware GOMAXPROCS (cgroup, mountinfo) and T168's scan of
  # its own descriptors. The net tables are denied explicitly, for the process
  # and per-thread views, so a later broadening of the allow rules cannot
  # re-expose them. `*` also matches `sys`, so the deny covers
  # /proc/sys/net/** too: Go's read of the listen backlog limit
  # (/proc/sys/net/core/somaxconn) is denied, and its net package falls back
  # to its built-in constant (the kernel still caps the backlog at somaxconn).
  /proc/*/cgroup r,
  /proc/*/mountinfo r,
  /proc/*/fd/ r,
  deny /proc/*/net/** r,
  deny /proc/*/task/*/net/** r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,
  /sys/fs/cgroup/cpu.max r,
  /tmp/ rw,
  /tmp/** rwk,

  # T170 / Principles II and III: Go coordinates all-thread confinement with
  # self-signals; the trusted host must still be able to stop the route.
  signal (send, receive) peer=stargate-dp,
  signal (receive) set=(int, term, kill) peer=unconfined,
  signal (receive) set=(int, term, kill) peer=runc,

  # The browser-facing listener is TCP only. Owner-match rules restrict its
  # egress to loopback replies; no UDP, raw or packet sockets are required.
  network inet stream,
  network inet6 stream,

  # AppArmor mediates pathname sockets through the file rules above. Its
  # AF_UNIX operation rule must allow the socket lifecycle as well; explicit
  # local and peer denies close the abstract namespace (including autobind).
  unix (create,bind,listen,accept,connect,send,receive,getattr,shutdown,getopt,setopt) type=stream,
  deny unix addr=@**,
  deny unix peer=(addr=@**),
}
